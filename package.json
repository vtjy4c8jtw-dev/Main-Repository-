{
  "name": "strava-running-dashboard",
  "version": "1.0.0",
  "description": "A running dashboard that analyzes your Strava data and builds personalized training plans",
  "main": "backend/src/index.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "test": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": ["strava", "running", "training-plan", "dashboard", "analytics"],
  "author": "vtjy4c8jtw-dev",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
